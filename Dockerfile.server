# Multi-stage Dockerfile for NEVP Stock Manager Backend API
FROM node:20-alpine AS builder

# Install build dependencies for better-sqlite3 native compilation on Alpine
RUN apk add --no-cache python3 make g++ gcc

WORKDIR /app

# Copy root package files
COPY package*.json ./

# Install all dependencies including native modules
RUN npm ci

# Production runtime image
FROM node:20-alpine AS runner

WORKDIR /app

# Install runtime dependencies for SQLite and healthchecks
RUN apk add --no-cache libstdc++ wget

# Set environment
ENV NODE_ENV=production
ENV PORT=5000

# Copy node_modules from builder
COPY --from=builder /app/node_modules ./node_modules
COPY package*.json ./
COPY server ./server

# Create data directory for persistent SQLite database volume
RUN mkdir -p /app/data
ENV DB_PATH=/app/data/stock_manager.db

EXPOSE 5000

CMD ["node", "server/server.js"]
