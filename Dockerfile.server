# Production Dockerfile for NEVP Stock Manager Backend API using Debian Slim (glibc)
# This guarantees 100% stable execution for better-sqlite3 native C++ bindings
FROM node:20-slim

# Install build tools for native compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install dependencies and compile better-sqlite3 in place
RUN npm ci

# Copy server code
COPY server ./server

# Create data directory for persistent SQLite database volume
RUN mkdir -p /app/data
ENV DB_PATH=/app/data/stock_manager.db
ENV NODE_ENV=production
ENV PORT=5000

EXPOSE 5000

CMD ["node", "server/server.js"]
