# Production Dockerfile for NEVP Stock Manager Backend API using Node 22 (LTS) Debian Bookworm Slim
# Node 22 provides full Node-API 10/11 compatibility required by better-sqlite3 v13
FROM node:22-bookworm-slim

# Install build tools for native compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install dependencies and explicitly rebuild better-sqlite3 from source
RUN npm ci && npm rebuild better-sqlite3 --build-from-source
RUN node -e "const Database = require('better-sqlite3'); const db = new Database(':memory:'); console.log('[Build Test] SQLite initialized successfully.');"

# Copy server code
COPY server ./server

# Create data directory for persistent SQLite database volume
RUN mkdir -p /app/data
ENV DB_PATH=/app/data/stock_manager.db
ENV NODE_ENV=production
ENV PORT=5000

EXPOSE 5000

CMD ["node", "server/server.js"]
